{
  "expo": {
    "name": "Unny",
    "slug": "unny",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F5F7FA",
      "translucent": false,
      "hidden": false
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unny.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Unny needs access to your photo library to upload documents.",
        "NSCameraUsageDescription": "Unny needs access to your camera to scan documents."
      }
    },
    "android": {
      "package": "com.unny.app",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C2B4A"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7FA",
          "resizeMode": "contain",
          "image": "./assets/splash.png"
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "unny",
    "extra": {
      "eas": {
        "projectId": "94ea23cd-6d96-40b2-aec6-57ed708695ce"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/94ea23cd-6d96-40b2-aec6-57ed708695ce"
    }
  }
}
