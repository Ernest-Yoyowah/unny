{
  "expo": {
    "name": "Unny",
    "slug": "unny",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F5F7FA",
      "translucent": false,
      "hidden": false
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1C2B4A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unny.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Unny needs access to your photo library to upload documents.",
        "NSCameraUsageDescription": "Unny needs access to your camera to scan documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C2B4A"
      },
      "package": "com.unny.app",
      "permissions": ["READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": ["expo-secure-store"],
    "scheme": "unny",
    "experiments": {
      "newArchEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "unny-project-id"
      }
    }
  }
}
